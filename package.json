{
  "name": "alcos-asistencia-pc",
  "version": "0.1.3",
  "description": "Software de registro de movimientos de personal - ALCOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.alcos.asistenciapc",
    "productName": "Alcos Asistencia PC",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ],
      "language": "3082"
    },
    "publish": {
      "provider": "github",
      "owner": "grovercomsol-ux",
      "repo": "alcos-asistencia-pc",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
